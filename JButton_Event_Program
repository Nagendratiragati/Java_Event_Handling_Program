import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
class SwingDemo extends JFrame implements ActionListener
{
public static void main(String [] args)
{
  SwingDemo obj = new SwingDemo();
  }
  JButton btn =new JButton("Press the Button");
  JLabel label = new JLabel("open the button");
  SwingDemo()
  {
   super("Swing Example");
   setSize(200,150);
  getContentPane().setLayout(new FlowLayout());
  label.setText("open the button");
   getContentPane().add(btn);
   getContentPane().add(label);
   btn.addActionListener(this);
   addWindowListener(
	   new WindowAdapter(){
   public void windowClosing(WindowEvent we){
     System.exit(0);
	 }});
	 setVisible(true);
  }
	 public void actionPerformed(ActionEvent ae)
	 {
	  label.setText("close the Button");
	  }
	  }
	  
	 
